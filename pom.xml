<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- +===================================== -->
    <!-- | Section 1: Parent inclusion          -->
    <!-- +===================================== -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
    </parent>

    <!-- +===================================== -->
    <!-- | Section 2: Project information       -->
    <!-- +===================================== -->
    <groupId>org.hellstrand</groupId>
    <artifactId>k8s-renfi</artifactId>
    <version>${revision}${changelist}</version>
    <name>k8s-renfi</name>
    <description>A modern k8s application for processing media files.</description>
    <packaging>pom</packaging>

    <!-- +===================================== -->
    <!-- | Section 3: Modules                   -->
    <!-- +===================================== -->
    <modules>
        <module>instructor</module>
        <module>executor</module>
        <module>shared</module>
    </modules>

    <!-- +===================================== -->
    <!-- | Section 4: Properties                -->
    <!-- +===================================== -->
    <properties>
        <revision>0.2.0</revision>
        <changelist>-SNAPSHOT</changelist>

        <!-- Project configurations -->
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>

        <!-- Internal dependencies -->
        <!-- External dependencies -->

        <!-- Plugins -->
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>

        <!-- CVE vulnerabilities -->
        <jackson-2-bom.version>2.23.0</jackson-2-bom.version>
        <jackson-bom.version>3.3.0</jackson-bom.version>
        <json-smart.version>2.6.1</json-smart.version>
        <logback.version>1.6.6</logback.version>
        <tomcat.version>11.0.27</tomcat.version>
    </properties>

    <!-- +===================================== -->
    <!-- | Section 5: DependencyManagement      -->
    <!-- +===================================== -->
    <dependencyManagement>
        <dependencies>
            <!-- +===================================== -->
            <!-- | CVE vulnerabilities                  -->
            <!-- +===================================== -->
            <!-- +===================================== -->
            <!-- | Internal dependencies                -->
            <!-- +===================================== -->
            <!-- +===================================== -->
            <!-- | External dependencies                -->
            <!-- +===================================== -->
        </dependencies>
    </dependencyManagement>

    <!-- +===================================== -->
    <!-- | Section 6: Dependencies              -->
    <!-- +===================================== -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>com.vaadin.external.google</groupId>
                    <artifactId>android-json</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <!-- +===================================== -->
    <!-- | Section 7: Build                     -->
    <!-- +===================================== -->
    <build>
        <!-- +===================================== -->
        <!-- | PluginManagement                     -->
        <!-- +===================================== -->
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <!-- +===================================== -->
        <!-- | Plugins                              -->
        <!-- +===================================== -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <!-- +===================================== -->
    <!-- | Section 8: Profiles                  -->
    <!-- +===================================== -->
    <profiles>
    </profiles>

</project>
